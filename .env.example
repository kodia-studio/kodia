# Database Configuration
DATABASE_USER=kodia
DATABASE_PASSWORD=change-me-in-production
DATABASE_NAME=kodia_db
DATABASE_TIMEZONE=UTC

# Redis Configuration
REDIS_PASSWORD=change-me-in-production

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=http://localhost

# Meilisearch Configuration (optional, for full-text search)
MEILISEARCH_MASTER_KEY=change-me-in-production

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# Email Configuration (choose one provider)
# MAIL_DRIVER=smtp|resend|mailgun|ses
MAIL_DRIVER=smtp
MAIL_FROM_NAME=Kodia
MAIL_FROM_ADDRESS=noreply@kodia.local
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Storage Configuration
STORAGE_DRIVER=local
STORAGE_PATH=storage/

# Optional: For S3/Cloudflare R2
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-bucket

# Sentry Configuration (optional)
# SENTRY_DSN=https://your-sentry-dsn

# Feature Flags
ENABLE_2FA=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_WEBHOOKS=true
